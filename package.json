{
  "name": "djfl-blog-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && node scripts/astro.mjs dev --host 127.0.0.1",
    "edit": "node scripts/studio-launch.mjs",
    "build": "node scripts/prepare-assets.mjs && node scripts/astro.mjs build && node scripts/check-release.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "migrate": "node scripts/migrate-hexo.mjs",
    "backup": "node scripts/backup-hexo.mjs",
    "new": "node scripts/new-post.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test": "node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.8",
    "github-slugger": "2.0.0",
    "parse5": "8.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.10.0",
    "typescript": "6.0.3"
  }
}
