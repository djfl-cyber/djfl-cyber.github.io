{
  "schemaVersion": 1,
  "id": "friends",
  "title": "友链",
  "route": "/friends/",
  "scope": "page",
  "root": {
    "id": "friends-root",
    "type": "container",
    "name": "页面容器",
    "props": {
      "className": "page-shell interior-page"
    },
    "children": [
      {
        "id": "friends-intro",
        "type": "container",
        "name": "页面介绍",
        "props": {
          "tag": "header",
          "className": "page-intro"
        },
        "children": [
          {
            "id": "friends-eyebrow",
            "type": "text",
            "name": "眉题",
            "props": {
              "className": "eyebrow"
            },
            "bindings": {
              "text": "pages.friends.eyebrow"
            }
          },
          {
            "id": "friends-title",
            "type": "text",
            "name": "页面标题",
            "props": {
              "tag": "h1"
            },
            "bindings": {
              "text": "pages.friends.title"
            }
          },
          {
            "id": "friends-description",
            "type": "text",
            "name": "页面介绍",
            "bindings": {
              "text": "pages.friends.description"
            }
          }
        ]
      },
      {
        "id": "friends-content",
        "type": "directory",
        "name": "友链列表",
        "props": {
          "source": "friends"
        }
      }
    ]
  }
}
