{
  "schemaVersion": 1,
  "id": "about",
  "title": "关于",
  "route": "/about/",
  "scope": "page",
  "root": {
    "id": "about-root",
    "type": "container",
    "name": "页面容器",
    "props": {
      "className": "page-shell interior-page"
    },
    "children": [
      {
        "id": "about-intro",
        "type": "container",
        "name": "页面介绍",
        "props": {
          "tag": "header",
          "className": "page-intro"
        },
        "children": [
          {
            "id": "about-eyebrow",
            "type": "text",
            "name": "眉题",
            "props": {
              "className": "eyebrow"
            },
            "bindings": {
              "text": "pages.about.eyebrow"
            }
          },
          {
            "id": "about-title",
            "type": "text",
            "name": "页面标题",
            "props": {
              "tag": "h1"
            },
            "bindings": {
              "text": "pages.about.title"
            }
          },
          {
            "id": "about-description",
            "type": "text",
            "name": "页面介绍",
            "bindings": {
              "text": "pages.about.description"
            }
          }
        ]
      },
      {
        "id": "about-content",
        "type": "profile",
        "name": "个人介绍"
      }
    ]
  }
}
