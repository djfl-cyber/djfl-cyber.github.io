---
import PageLayout from '../layouts/PageLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import {navigation,pages,text} from '../lib/settings';
const categories=[...new Set(navigation.map(item=>item.category))];
---
<PageLayout {...pages.navigation}>
  {navigation.length===0?<EmptyState title={pages.navigation.empty} description={pages.navigation.emptyDetail} icon="compass"/>:<div data-directory><div class="directory-controls"><label class="search-field"><Icon name="search"/><span class="sr-only">搜索导航网站</span><input type="search" data-directory-search placeholder={pages.navigation.searchPlaceholder}/></label><div class="filter-chips" aria-label="网站分类"><button data-filter="" aria-pressed="true">{text.directory.all}</button>{categories.map(category=><button data-filter={category} aria-pressed="false">{category}</button>)}</div></div><div class="directory-grid">{navigation.map(item=><a class="directory-card" data-directory-item data-category={item.category} data-search={`${item.name} ${item.description} ${item.category}`.toLowerCase()} href={item.url} target="_blank" rel="noopener noreferrer"><span class="directory-initial">{item.name.slice(0,1)}</span><div><span class="eyebrow">{item.category}</span><h2>{item.name}</h2><p>{item.description}</p></div><Icon name="diagonal" size={16}/></a>)}</div><p data-no-results hidden class="empty-state" role="status">{pages.navigation.noResults}</p></div>}
</PageLayout>
