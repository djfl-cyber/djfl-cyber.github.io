---
import {Image} from 'astro:assets';
import avatar from '../assets/legacy/head.jpg';
import PageLayout from '../layouts/PageLayout.astro';
import {site,pages} from '../lib/settings';
import Icon from '../components/Icon.astro';
---
<PageLayout {...pages.about}><section class="about-card"><Image src={avatar} width={120} height={120} format="webp" alt={`${site.author} 的头像`} class="about-avatar"/><div><h2>{site.author}<span class="accent">.</span></h2><p>{site.about}</p><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/>GitHub<Icon name="diagonal" size={15}/></a></div></section></PageLayout>
