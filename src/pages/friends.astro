---
import PageLayout from '../layouts/PageLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import {friends,pages} from '../lib/settings';
const categories=[...new Set(friends.map(f=>f.category))];
---
<PageLayout {...pages.friends}>{friends.length===0?<EmptyState title={pages.friends.empty} description={pages.friends.emptyDetail}/>:categories.map(category=><section class="directory-section"><h2>{category}</h2><div class="directory-grid">{friends.filter(f=>f.category===category).map(friend=><a class="directory-card" href={friend.url} target="_blank" rel="noopener noreferrer">{friend.image?<img src={friend.image} alt="" width="48" height="48" loading="lazy"/>:<span class="directory-initial">{friend.name.slice(0,1)}</span>}<div><h3>{friend.name}</h3><p>{friend.description}</p></div><Icon name="diagonal" size={16}/></a>)}</div></section>)}</PageLayout>
