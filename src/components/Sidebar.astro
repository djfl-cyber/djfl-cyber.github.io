---
import {Image} from 'astro:assets';
import avatar from '../assets/legacy/head.jpg';
import {site,home,text} from '../lib/settings';
import {dateParts,type Post} from '../lib/content';
import Icon from './Icon.astro';
interface Props {posts:Post[]}
const {posts}=Astro.props;
const months=Object.entries(posts.reduce<Record<string,number>>((all,p)=>{const d=dateParts(p.data.date);const key=`${d.year}/${d.month}`;all[key]=(all[key]??0)+1;return all;},{})).slice(0,4);
---
<aside class="home-sidebar" aria-label="作者与归档">
  {home.sidebar.showAuthor&&<section class="profile-panel">
    <div class="profile-top"><Image src={avatar} width={64} height={64} format="webp" alt={`${site.author} 的头像`} class="avatar"/><span class="status-label"><i/>{text.sidebar.status}</span></div>
    <h2>{site.author}<span>.</span></h2><p>{site.authorBio}</p>
    <div class="profile-stats"><a href="/archives/"><strong>{posts.length.toString().padStart(2,'0')}</strong><span>{text.sidebar.postCount}</span></a><div><strong>{site.startYear}</strong><span>{text.sidebar.startYear}</span></div></div>
    <a class="text-link" href="/about/">{text.sidebar.aboutLink}<Icon name="arrow" size={16}/></a>
  </section>}
  {home.sidebar.showArchive&&<section class="sidebar-section"><div class="eyebrow">{text.sidebar.archiveEyebrow}</div><h2>{text.sidebar.archiveTitle}</h2><ul class="month-list">{months.map(([month,count])=><li><a href={`/archives/${month}/`}><span>{month.replace('/',' 年 ')} 月</span><span class="count mono">{String(count).padStart(2,'0')}</span></a></li>)}</ul></section>}
  {home.sidebar.showNote&&<section class="small-note"><span class="note-asterisk" aria-hidden="true">✳</span><h2>{home.sidebar.noteTitle}</h2><p>{home.sidebar.note}</p><span class="mono">{text.sidebar.noteCaption}</span></section>}
</aside>
