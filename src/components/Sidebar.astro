---
import {Image} from 'astro:assets';
import avatar from '../assets/legacy/head.jpg';
import * as defaults from '../lib/settings';
import {dateParts,type Post} from '../lib/content';
import MultilineText from './MultilineText.astro';
import Icon from './Icon.astro';
interface Props {posts:Post[];nodeAttrs?:Record<string,string>;settings?:any}
const {posts,nodeAttrs={},settings=defaults}=Astro.props;
const {site,home,text}=settings;
const months=Object.entries(posts.reduce<Record<string,number>>((all,p)=>{const d=dateParts(p.data.date);const key=`${d.year}/${d.month}`;all[key]=(all[key]??0)+1;return all;},{})).slice(0,4);
---
<aside class="home-sidebar" aria-label="作者与归档" {...nodeAttrs}>
  {home.sidebar.showAuthor&&<section class="profile-panel">
    <div class="profile-top">{site.avatar?<img src={site.avatar} width="64" height="64" alt={`${site.author} 的头像`} class="avatar"/>:<Image src={avatar} width={64} height={64} format="webp" alt={`${site.author} 的头像`} class="avatar"/>}<span class="status-label"><i/><MultilineText value={text.sidebar.status} wrap/></span></div>
    <h2><MultilineText value={site.author}/><span>.</span></h2><p><MultilineText value={site.authorBio}/></p>
    <div class="profile-stats"><a href="/archives/"><strong>{posts.length.toString().padStart(2,'0')}</strong><span><MultilineText value={text.sidebar.postCount}/></span></a><div><strong>{site.startYear}</strong><span><MultilineText value={text.sidebar.startYear}/></span></div></div>
    <a class="text-link" href="/about/"><MultilineText value={text.sidebar.aboutLink} wrap/><Icon name="arrow" size={16}/></a>
  </section>}
  {home.sidebar.showArchive&&<section class="sidebar-section"><div class="eyebrow"><MultilineText value={text.sidebar.archiveEyebrow}/></div><h2><MultilineText value={text.sidebar.archiveTitle}/></h2><ul class="month-list">{months.map(([month,count])=><li><a href={`/archives/${month}/`}><span>{month.replace('/',' 年 ')} 月</span><span class="count mono">{String(count).padStart(2,'0')}</span></a></li>)}</ul></section>}
  {home.sidebar.showNote&&<section class="small-note"><span class="note-asterisk" aria-hidden="true">✳</span><h2><MultilineText value={home.sidebar.noteTitle}/></h2><p><MultilineText value={home.sidebar.note}/></p><span class="mono"><MultilineText value={text.sidebar.noteCaption}/></span></section>}
</aside>
