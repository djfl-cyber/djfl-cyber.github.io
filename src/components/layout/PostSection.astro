---
import TableOfContents from '../TableOfContents.astro';
import Icon from '../Icon.astro';
import {dateLabel,readingTime,type Post} from '../../lib/content';
interface Props {kind:string;nodeAttrs:Record<string,string>;settings:any;context:{post:Post;headings:any[];previous?:Post;next?:Post;showToc:boolean}}
const {kind,nodeAttrs,settings,context}=Astro.props;
const {post,headings,previous,next,showToc}=context;
const {text}=settings;
---
{kind==='post-header'?<header class="article-header" {...nodeAttrs}><div class="eyebrow">{text.article.eyebrow} / {post.data.categories[0]??text.article.fallbackCategory}</div><h1>{post.data.title}</h1><div class="post-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span class="meta-dot"/><span>{readingTime(post)} {text.article.readingUnit}</span>{post.data.updated&&<span>{text.article.updated} {dateLabel(post.data.updated)}</span>}{post.data.draft&&<span class="draft-badge">{text.article.draftPreview}</span>}</div>{post.data.tags.length>0&&<div class="article-tags">{post.data.tags.map(tag=><a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>}</header>:kind==='post-body'?<article class="prose" id="article-content" data-article {...nodeAttrs}><slot/></article>:kind==='post-end'?<div class="article-end" {...nodeAttrs}><span>✳</span><p>{text.article.thanks}</p><a href="#main">{text.article.backTop}</a></div>:kind==='post-nav'?<nav class="adjacent-posts" aria-label="相邻文章" {...nodeAttrs}>{previous?<a href={previous.data.permalink}><span>{text.article.newer}</span><strong>{previous.data.title}</strong></a>:<div/>}{next?<a href={next.data.permalink}><span>{text.article.older}</span><strong>{next.data.title}</strong></a>:<div/>}</nav>:kind==='post-toc'&&showToc?<aside class="post-toc" {...nodeAttrs}><div class="toc-heading"><span class="eyebrow">{text.article.tocEyebrow}</span><span class="mono" data-reading-percent>0%</span></div><h2>{text.article.toc}</h2><TableOfContents headings={headings}/></aside>:kind==='post-mobile-toc'&&showToc?<div {...nodeAttrs} style="display:contents"><button class="mobile-toc-button" data-open-toc><Icon name="list" size={18}/>{text.article.toc}</button><dialog class="toc-dialog" data-toc-dialog><div class="dialog-heading"><h2>{text.article.toc}</h2><button class="icon-button" data-close-toc aria-label="关闭目录"><Icon name="close"/></button></div><TableOfContents headings={headings}/></dialog></div>:null}
