---
import {Image} from 'astro:assets';
import avatar from '../assets/legacy/head.jpg';
import Icon from './Icon.astro';
import MultilineText from './MultilineText.astro';
interface Props {settings:any;nodeAttrs?:Record<string,string>;className?:string}
const {settings,nodeAttrs={},className}=Astro.props;
const {site}=settings;
---
<div {...nodeAttrs} class={className}>
  <section class="about-card">
    {site.avatar?<img src={site.avatar} width="120" height="120" alt={`${site.author} 的头像`} class="about-avatar"/>:<Image src={avatar} width={120} height={120} format="webp" alt={`${site.author} 的头像`} class="about-avatar"/>}
    <div><h2><MultilineText value={site.author}/><span class="accent">.</span></h2><p><MultilineText value={site.about}/></p><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/>GitHub<Icon name="diagonal" size={15}/></a></div>
  </section>
</div>
