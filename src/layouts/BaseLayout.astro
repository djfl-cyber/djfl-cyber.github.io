---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WidgetHost from '../components/WidgetHost.astro';
import {site,appearance,themeVariables,text} from '../lib/settings';
import '../styles/global.css';
import '../styles/article.css';
interface Props {title?:string;description?:string;canonical?:string;article?:boolean;noindex?:boolean}
const {title,description=site.description,canonical=Astro.url.pathname,article=false,noindex=false}=Astro.props;
const fullTitle=title?`${title} · ${site.title}`:site.title;
const canonicalUrl=new URL(canonical,site.site).href;
---
<!doctype html>
<html lang={site.language} data-theme={appearance.defaultTheme==='dark'?'dark':'light'} data-decorations={String(appearance.decorations)} style={themeVariables}>
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{fullTitle}</title><meta name="description" content={description}/><meta name="author" content={site.author}/>
    <link rel="canonical" href={canonicalUrl}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalUrl}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:site_name" content={site.title}/>
    {noindex&&<meta name="robots" content="noindex,follow"/>}
    <script is:inline define:vars={{defaultTheme:appearance.defaultTheme}}>
      try { const saved=localStorage.getItem('djfl-theme');document.documentElement.dataset.theme=(saved==='light'||saved==='dark')?saved:(defaultTheme==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):defaultTheme); } catch {}
    </script>
  </head>
  <body data-code-copy={text.article.copy} data-code-copied={text.article.copied} data-code-failed={text.article.copyFailed} data-code-expand={text.article.expand} data-code-collapse={text.article.collapse}>
    <a href="#main" class="skip-link">跳到正文</a>
    <Header/>
    <main id="main" tabindex="-1"><slot/></main>
    <Footer/><WidgetHost/>
    <script>import '../../scripts/client';</script>
  </body>
</html>
